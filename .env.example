# ClaimGuard Environment Configuration Template
# Copy this file to .env and insert your actual credentials

# Groq AI Service Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# MongoDB Atlas Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=claimguard
PORT=8000

# Service & Deployment URLs
# Frontend URL (whitelisted in Backend CORS origins)
FRONTEND_URL=http://localhost:5173

# Backend URL (used by Frontend React app to communicate with API)
BACKEND_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000/api
