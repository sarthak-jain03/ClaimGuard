# ClaimGuard Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual credentials

# Groq AI Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=claimguard
PORT=8000

# Service & Deployment URLs
# FRONTEND_URL: Used by Backend CORS to allow incoming browser requests.
# In local dev: http://localhost:5173
# In production: https://your-frontend-domain.vercel.app (comma-separated if multiple)
FRONTEND_URL=http://localhost:5173

# BACKEND_URL: The address where the backend is hosted
# In local dev: http://localhost:8000
# In production: https://your-backend-service.onrender.com
BACKEND_URL=http://localhost:8000

# VITE_API_BASE_URL: The full API endpoint base URL used by the React frontend
# In local dev: http://localhost:8000/api
# In production: https://your-backend-service.onrender.com/api
VITE_API_BASE_URL=http://localhost:8000/api
